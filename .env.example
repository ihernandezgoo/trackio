# Copia este archivo a .env.local y rellena los valores de tu proyecto Firebase.
# .env.local está en .gitignore: nunca subas credenciales al repositorio.

# URL de la Realtime Database (Firebase Console > Realtime Database).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Servidor (Firebase Console > Configuración > Cuentas de servicio > Generar clave) ---
# ESTO ES SECRETO. Da acceso total al proyecto: no lo expongas jamás.
# Todo el acceso a datos ocurre en el servidor con estas credenciales, así que
# las reglas de database.rules.json pueden quedarse completamente cerradas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada entera entre comillas, con los \n literales tal cual vienen en el JSON.
FIREBASE_PRIVATE_KEY=""

# Identificador del propietario de los datos. Trackio es de un solo usuario:
# no hay login, y el servidor lee y escribe siempre bajo este uid.
# Puede ser cualquier cadena estable; si vienes de la versión con autenticación,
# usa el uid de Firebase Auth para conservar tus registros.
TRACKIO_UID=
